# Rust build artifacts
/target
**/target

# Generated Cargo.toml files (legitimate source Cargo.toml files should be tracked)
# This covers any Cargo.toml generated during builds outside of target/
**/target/**/Cargo.toml

# Temporary files
tmp/
tmp2/
*.tmp
*.temp

# Application specific
.dashbeam-*
.sendme-*

# Self-hosted relay config (per-deployment values; may contain secrets)
infra/relay/iroh-relay.conf
# Self-hosted discovery config (per-deployment values)
infra/dns/config.toml

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
*.log
logs/

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Coverage reports
coverage/
*.lcov

# Temporary folders
.tmp/
.temp/

# Markdown files (except README files)
*.md
!feature-request.md
!PULL_REQUEST_TEMPLATE.md
!report-bug.md
!README.md
!README
!**/README.md
!**/README
!**/README*.md
!PRIVACY.md
!CONTRIBUTING.md
!SECURITY.md
!CODE_OF_CONDUCT.md

# Project docs (kept local; not published)
# Use docs/* (not docs/) so docs/readme/ can be re-included
docs/*
!docs/readme/
!docs/readme/**
# User-facing; linked from README and the bug report template
!docs/troubleshooting.md

.github-reference/
.github-reference-readest/
monorepo-reference

random

# Nix / direnv (flake.nix, flake.lock and .envrc are tracked)
.direnv/
result
result-*
.envrc.local

